# ==============================================================================
# CV Banong Farms - Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Rekomendasi untuk Chatbot Si Banong & Analisis Pemasaran)
# Dapatkan di: https://aistudio.google.com/app/apikey
# Model default: gemini-1.5-flash
VITE_GEMINI_API_KEY=

# OpenAI API Key (Alternatif opsional)
# Dapatkan di: https://platform.openai.com/api-keys
# Model default: gpt-4o-mini
VITE_OPENAI_API_KEY=

# Supabase Cloud Database (Online 24/7 & Real-Time)
# Dapatkan di: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CATATAN PENTING:
# Kunci API juga dapat langsung diatur melalui browser di:
# Dashboard Admin (Pusat Komando) -> Tombol "AI Token (1M)" di pojok kanan atas.
# Kunci akan tersimpan aman di LocalStorage browser tanpa perlu rebuild aplikasi!
